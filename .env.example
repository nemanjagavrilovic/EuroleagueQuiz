POSTGRES_CONNECTION_STRING=Host=db.example.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=change-me;SSL Mode=Require;Trust Server Certificate=true
PUBLIC_ORIGIN=https://pickandroll.io

# Generate at least 32 random bytes. Never reuse a database or Google secret here.
JWT_SIGNING_KEY=replace-with-a-long-random-signing-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=

# Resend HTTPS API.
RESEND_API_KEY=re_replace_with_resend_api_key
RESEND_FROM_ADDRESS=noreply@pickandroll.io
